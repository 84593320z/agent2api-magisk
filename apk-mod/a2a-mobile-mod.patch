--- /dev/null
+++ b/desktop-tauri/mobile/src/api/switches.ts
@@ -0,0 +1,210 @@
+/**
+ * 网关功能开关：与桌面面板「设置 → 网关」里的那组开关**同一批端点、同一批字段**。
+ *
+ * ── 为什么单独一个模块 ────────────────────────────────────────
+ * 这些开关在服务端是 6 个独立端点 + 1 个 `/api/routing`（三个自愈开关共用），
+ * 每个端点的读写形状完全同构：`GET` 读全量状态、`PUT` 写**部分**字段、
+ * 响应体就是写入后的新状态。把这个规律收敛在一张表里，加一个开关只改一行，
+ * 而不是在页面里散落 9 段 fetch。
+ *
+ * ── 为什么字段名照抄后端 ──────────────────────────────────────
+ * 后端键（`sanitizeBlacklistFingerprints` 这类）与前端展示名没有推导关系。
+ * 桌面端踩过一次坑（`PROTECTION_STATE_FIELD` 的注释里写着「拼出来的名字一旦
+ * 对不上，表现是开关点了没反应」），这里同样显式列表，不拼字符串。
+ *
+ * ── 双向同步是怎么成立的 ──────────────────────────────────────
+ * 没有推送通道，靠「同一份服务端状态 + 两端各自回读」：
+ *   · 面板改了 → 手机端在设置页可见时每 5 秒回读一次（见 SettingsPage），
+ *     切回前台也会立刻回读；
+ *   · 手机改了 → PUT 成功后响应体就是新状态，界面直接用它渲染；面板下次
+ *     刷新自然读到。
+ * 写操作是**幂等**的（PUT 同一份值），所以两边同时拨不会互相打架。
+ */
+
+import { apiCall } from './client'
+
+/** 开关所属分组：网关行为 / 路由自愈（与桌面设置页的两个小节对应） */
+export type SwitchGroup = 'gateway' | 'protection'
+
+export type SwitchId =
+  | 'sanitize'
+  | 'developerRoleCompat'
+  | 'cors'
+  | 'debug'
+  | 'captcha'
+  | 'modelsDev'
+  | 'failoverBackoff'
+  | 'sink'
+  | 'breaker'
+
+export type SwitchDef = {
+  id: SwitchId
+  group: SwitchGroup
+  /** GET 读 / PUT 写的端点 */
+  path: string
+  /** 请求与响应里的字段名（照抄后端，不推导） */
+  field: string
+  /** 字段缺失时的口径，与桌面端各 render 函数保持一致 */
+  fallback: boolean
+  /** 展示用文案（中文原文即 i18n key，其余语种查不到时回落中文） */
+  label: string
+  hint: string
+}
+
+export const SWITCH_DEFS: SwitchDef[] = [
+  {
+    id: 'sanitize',
+    group: 'gateway',
+    path: '/api/sanitize',
+    field: 'sanitizeBlacklistFingerprints',
+    fallback: false,
+    label: '出站指纹脱敏',
+    hint: '剥离上游审核黑名单指纹：改写请求体里的模板句与表头',
+  },
+  {
+    id: 'developerRoleCompat',
+    group: 'gateway',
+    path: '/api/developer-role-compat',
+    field: 'developerRoleCompat',
+    fallback: false,
+    label: '开发者角色兼容',
+    hint: '转发前把 developer 角色消息转成 system，兼容不认该角色的上游',
+  },
+  {
+    id: 'cors',
+    group: 'gateway',
+    path: '/api/cors',
+    field: 'corsEnabled',
+    fallback: false,
+    label: '网关跨域访问',
+    hint: '允许浏览器里的页面跨来源调用网关 /v1/*',
+  },
+  {
+    id: 'debug',
+    group: 'gateway',
+    path: '/api/debug',
+    field: 'debugMode',
+    fallback: false,
+    label: '调试模式',
+    hint: '保存上游原始报文（请求头/体、响应头/体），排查时才有现场',
+  },
+  {
+    id: 'captcha',
+    group: 'gateway',
+    path: '/api/captcha',
+    // 3.4.0 起后端把这一项拆成桌面端 / headless 两端（captchaDesktop /
+    // captchaWeb），登录端点按本进程形态 localPanel 选一边读；旧键
+    // captchaEnabled 仍被接受、且会同时写两端。这里读「当前这一端」的实际值
+    // （见 pick 的特判），写的时候用旧键一次写两端 —— 手机用户看到的是
+    // 「我这台设备的登录要不要过人机校验」，不会出现只关了一半的状态。
+    field: 'captchaEnabled',
+    fallback: true,
+    label: '登录人机校验',
+    hint: '登录 / 注册需要通过 ALTCHA 人机验证（工作量证明）',
+  },
+  {
+    id: 'modelsDev',
+    group: 'gateway',
+    path: '/api/models/metadata',
+    field: 'modelsDevEnabled',
+    fallback: true,
+    label: 'models.dev 元数据',
+    hint: '用 models.dev 补齐上游没声明的模型能力与思考档位（联网刷新）',
+  },
+  {
+    id: 'failoverBackoff',
+    group: 'protection',
+    path: '/api/routing',
+    field: 'routingFailoverBackoff',
+    fallback: true,
+    label: '失败退避',
+    hint: '失败账号休息 15 分钟起步、连续失败翻倍、成功一次立即恢复',
+  },
+  {
+    id: 'sink',
+    group: 'protection',
+    path: '/api/routing',
+    field: 'routingSink',
+    fallback: true,
+    label: '限流垫底',
+    hint: '有额度却被 429 的账号排到队尾，30 分钟后自动归队',
+  },
+  {
+    id: 'breaker',
+    group: 'protection',
+    path: '/api/routing',
+    field: 'routingBreakerEnabled',
+    fallback: false,
+    label: '熔断',
+    hint: '连续失败到阈值后整个账号跳过，要连续成功若干次才恢复',
+  },
+]
+
+/** 读到的开关状态；某个键缺失 = 该端点读失败，界面按「未知」处理（禁用而不是猜） */
+export type SwitchState = Partial<Record<SwitchId, boolean>>
+
+function pick(body: unknown, def: SwitchDef): boolean | undefined {
+  if (!body || typeof body !== 'object') return undefined
+  const object = body as Record<string, unknown>
+  // 人机校验：3.4.0 的响应是 `{captchaDesktop, captchaWeb, localPanel}`，
+  // 按本进程形态取对应那一端；更老的网关只有 `captchaEnabled` 单键。
+  if (def.id === 'captcha') {
+    const side = object.localPanel === false ? 'captchaWeb' : 'captchaDesktop'
+    const raw = object[side] ?? object.captchaEnabled
+    return typeof raw === 'boolean' ? raw : undefined
+  }
+  const raw = object[def.field]
+  return typeof raw === 'boolean' ? raw : undefined
+}
+
+/**
+ * 并发读全部开关。
+ *
+ * 按**端点**去重（`/api/routing` 一条请求喂三个开关），任一端点失败不影响其余
+ * —— 面板上某个功能被关掉时那个端点可能整个不可用，不能让整页跟着报错。
+ */
+export async function fetchSwitches(signal?: AbortSignal): Promise<SwitchState> {
+  const paths = Array.from(new Set(SWITCH_DEFS.map(def => def.path)))
+  const bodies = new Map<string, unknown>()
+  await Promise.all(
+    paths.map(async path => {
+      try {
+        bodies.set(path, await apiCall(path, { signal, quiet: true }))
+      } catch {
+        bodies.set(path, undefined)
+      }
+    }),
+  )
+  const state: SwitchState = {}
+  for (const def of SWITCH_DEFS) {
+    const value = pick(bodies.get(def.path), def)
+    if (value !== undefined) state[def.id] = value
+  }
+  return state
+}
+
+/**
+ * 写一个开关。返回**同端点上所有开关**的新值（响应体是整份状态）。
+ *
+ * 只有目标字段为 boolean 且严格等于请求值才算确认；缺字段、类型错误、反向回显
+ * 与网络失败一样抛错，由调用方删除乐观值并显示未知，绝不合成服务端确认。
+ */
+export async function saveSwitch(id: SwitchId, next: boolean): Promise<SwitchState> {
+  const def = SWITCH_DEFS.find(item => item.id === id)
+  if (!def) throw new Error(`Unknown switch: ${id}`)
+  if (typeof next !== 'boolean') throw new Error(`Invalid switch value: ${id}`)
+  const body = await apiCall(def.path, { method: 'PUT', body: { [def.field]: next } })
+  if (pick(body, def) !== next) throw new Error(`Switch write was not confirmed: ${id}`)
+  const state: SwitchState = {}
+  for (const item of SWITCH_DEFS) {
+    if (item.path !== def.path) continue
+    const value = pick(body, item)
+    if (value !== undefined) state[item.id] = value
+  }
+  return state
+}
+
+/** 分组 → 该组开关（渲染顺序就是表里的顺序） */
+export function switchesOf(group: SwitchGroup): SwitchDef[] {
+  return SWITCH_DEFS.filter(def => def.group === group)
+}
diff --git a/desktop-tauri/mobile/src/components/GatewaySwitches.tsx b/desktop-tauri/mobile/src/components/GatewaySwitches.tsx
new file mode 100644
index 0000000..aed51a5
--- /dev/null
+++ b/desktop-tauri/mobile/src/components/GatewaySwitches.tsx
@@ -0,0 +1,182 @@
+import { useCallback, useEffect, useRef, useState } from 'react'
+import { Card, Switch } from '@ui'
+import { SectionHead } from './ui'
+import { t } from '../i18n'
+import {
+  SWITCH_DEFS,
+  fetchSwitches,
+  saveSwitch,
+  type SwitchDef,
+  type SwitchId,
+  type SwitchState,
+} from '../api/switches'
+
+/**
+ * 网关功能开关（APK 专用）。
+ *
+ * 桌面面板的「设置 → 网关」里有这 9 个开关；手机端原本只能看，改一项要开电脑。
+ * 这里把它们搬到手机上，端点与字段和桌面端完全一致（表格在 api/switches.ts）。
+ *
+ * ── 三条必须守住的规则 ────────────────────────────────────────
+ * 1. **读不到就是未知，未知就禁用。** 端点失败时该键从 state 里消失，开关变灰，
+ *    绝不用旧值冒充——否则用户看到「已开启」，其实服务端根本没这个状态。
+ *    所以每轮回读都是**整份替换**（不是把新值并进旧对象）。
+ * 2. **写是串行的。** 同一端点上连点两个开关，后端返回的是整份状态；并发写会让
+ *    先发的响应覆盖后发的。这里用一条 promise 链把 PUT 排队。
+ * 3. **读不能跨越写屏障。** 写意图入队、写完成（含失败）都推进 epoch，丢弃跨越
+ *    任一屏障的旧 GET；pending 隔离在途意图，React 延迟 updater 也要复查代次。
+ */
+export function GatewaySwitches() {
+  const [state, setState] = useState<SwitchState>({})
+  const [ready, setReady] = useState(false)
+  const [error, setError] = useState('')
+  const [busy, setBusy] = useState<Set<SwitchId>>(() => new Set())
+
+  /** 在途写入：id → 目标值。回读时盖住这些键 */
+  const pending = useRef<Map<SwitchId, boolean>>(new Map())
+  /** 读写代次：后发 GET、写入队和写结算都会使旧 GET 作废 */
+  const epoch = useRef(0)
+  /** 写队列：PUT 串行 */
+  const chain = useRef<Promise<void>>(Promise.resolve())
+  const alive = useRef(true)
+
+  const load = useCallback(async () => {
+    const mine = ++epoch.current
+    const next = await fetchSwitches()
+    if (!alive.current || mine !== epoch.current) return
+    // 整份替换：这一轮没返回的键 = 该端点失败 = 未知（渲染成禁用）
+    setState(prev => {
+      // React 可以稍后才执行 updater；从 await 到提交之间也可能开始/完成一次写。
+      if (!alive.current || mine !== epoch.current) return prev
+      const merged: SwitchState = {}
+      for (const id of Object.keys(next) as SwitchId[]) merged[id] = next[id]
+      for (const [id, value] of pending.current) merged[id] = value
+      return merged
+    })
+    setReady(true)
+  }, [])
+
+  useEffect(() => {
+    alive.current = true
+    void load().catch(() => {
+      if (alive.current) setError(t('读取网关开关失败，稍后自动重试'))
+    })
+    const timer = window.setInterval(() => {
+      // 页面在后台时不必打扰网关；回到前台由 visibilitychange 立刻补一次
+      if (document.visibilityState === 'hidden') return
+      void load().catch(() => {})
+    }, 5000)
+    const onVisible = () => {
+      if (document.visibilityState === 'visible') void load().catch(() => {})
+    }
+    document.addEventListener('visibilitychange', onVisible)
+    return () => {
+      alive.current = false
+      window.clearInterval(timer)
+      document.removeEventListener('visibilitychange', onVisible)
+    }
+  }, [load])
+
+  const toggle = (id: SwitchId, next: boolean) => {
+    // 同键重复事件不再排队；不同键仍可进入全局串行队列。
+    if (pending.current.has(id)) return
+    ++epoch.current
+    pending.current.set(id, next)
+    setError('')
+    setState(prev => ({ ...prev, [id]: next }))
+    setBusy(prev => new Set(prev).add(id))
+    chain.current = chain.current.then(async () => {
+      try {
+        const patch = await saveSwitch(id, next)
+        if (!alive.current) return
+        // 在入队 updater 前固定隔离集合；finally 清 pending 不能改变延迟提交的语义。
+        const protectedIds = new Set(pending.current.keys())
+        protectedIds.delete(id)
+        setState(prev => {
+          const merged: SwitchState = { ...prev }
+          for (const [key, value] of Object.entries(patch) as [SwitchId, boolean][]) {
+            // 当前目标已由 API 严格确认；其余在途键保持各自意图。
+            if (!protectedIds.has(key) && (key === id || !pending.current.has(key))) merged[key] = value
+          }
+          return merged
+        })
+      } catch {
+        if (!alive.current) return
+        // 写失败：这个键回到「未知」而不是假装回到旧值——真实状态在服务端，
+        // 下一轮回读会拿到；在此之前禁用比显示一个可能是错的开关好。
+        setState(prev => {
+          const merged: SwitchState = { ...prev }
+          delete merged[id]
+          return merged
+        })
+        setError(t('开关保存失败，请检查网关是否可达'))
+      } finally {
+        // 包含 PUT 在途期间发出的 GET：成功/失败结算后都不能再用其旧快照。
+        ++epoch.current
+        pending.current.delete(id)
+        if (alive.current) {
+          setBusy(prev => {
+            const copy = new Set(prev)
+            copy.delete(id)
+            return copy
+          })
+        }
+      }
+    })
+  }
+
+  const groups: { key: string; title: string; items: SwitchDef[] }[] = [
+    { key: 'gateway', title: t('网关行为'), items: SWITCH_DEFS.filter(def => def.group === 'gateway') },
+    { key: 'protection', title: t('路由自愈'), items: SWITCH_DEFS.filter(def => def.group === 'protection') },
+  ]
+
+  return (
+    <>
+      {groups.map(group => (
+        <div className='m-section' key={group.key}>
+          <SectionHead title={group.title} />
+          <Card className='m-card'>
+            {group.items.map((def, index) => {
+              const value = state[def.id]
+              const disabled = !ready || value === undefined || busy.size > 0
+              return (
+                <div
+                  key={def.id}
+                  className='m-row'
+                  style={{
+                    alignItems: 'center',
+                    gap: 12,
+                    padding: '12px 14px',
+                    borderTop: index === 0 ? 'none' : '1px solid var(--m-line)',
+                  }}
+                >
+                  <div className='m-grow'>
+                    <div className='m-t1'>{t(def.label)}</div>
+                    <div className='m-t2' style={{ lineHeight: 1.55 }}>
+                      {ready && value === undefined ? t('当前读不到这一项的状态') : t(def.hint)}
+                    </div>
+                  </div>
+                  <Switch
+                    checked={value === true}
+                    disabled={disabled}
+                    size='touch'
+                    aria-label={t(def.label)}
+                    onCheckedChange={next => toggle(def.id, next === true)}
+                  />
+                </div>
+              )
+            })}
+          </Card>
+          {group.key === 'gateway' && !ready ? (
+            <div className='m-t2' style={{ padding: '6px 4px 0' }}>{t('正在读取网关状态…')}</div>
+          ) : null}
+        </div>
+      ))}
+      {error ? (
+        <div className='m-section' style={{ marginTop: -6 }}>
+          <div className='m-t2' style={{ color: 'var(--m-danger)' }}>{error}</div>
+        </div>
+      ) : null}
+    </>
+  )
+}
