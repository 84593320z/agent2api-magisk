# Agent2API 模块配置（/data/adb/agent2api/env.sh）
# 改完执行：sh /data/adb/modules/agent2api/bin/ctl restart
# 这个文件不会被模块升级覆盖。

# 监听地址：127.0.0.1 只给本机（手机自己浏览器 / adb forward）
# 想让电脑上的客户端直连，就改 0.0.0.0，然后先注册管理员并建一把网关 Key。
#
# ⚠ 改成 0.0.0.0 之前先做鉴权：面板的「首次注册」是开放的，在既没有
#   AGENT2API_PROXY_API_KEY、也没有 AGENT2API_ADMIN_USER 的情况下对外监听，
#   同一 Wi-Fi 下任何人都能抢先注册成管理员（服务在 chroot 内是 uid 0）。
#   这种组合模块会直接拒绝启动并写 $DATA/fatal 说明。
#   正确顺序：先 127.0.0.1 起服务 → 面板注册管理员/建 Key → 再改 0.0.0.0 → ctl restart。
AGENT2API_HOST=127.0.0.1

# 网关 + 面板端口
AGENT2API_PROXY_PORT=3065

# 面板拆到独立端口（可选）
#AGENT2API_PANEL_PORT=3066

# 预置网关 Key（可选，跳过面板手动创建）
#AGENT2API_PROXY_API_KEY=sk-a2a-换成你自己的随机串

# 预置管理员（可选，跳过首次注册；密码明文，启动时自动转 bcrypt）
#AGENT2API_ADMIN_USER=admin
#AGENT2API_ADMIN_PASSWORD=
#AGENT2API_ADMIN_PASSWORD_HASH=

# 未配 Key 时 /v1/* 默认拒绝（fail-closed），纯内网才考虑设 1
#AGENT2API_ALLOW_NO_KEY=0

# 登录页人机验证
AGENT2API_CAPTCHA_ENABLED=1

# 调试日志
#AGENT2API_VERBOSE=1

# 应用自身日志（chroot 内路径；默认 /var/log/agent2api/app.log，
# 对应手机上 /data/adb/agent2api/logs/app.log）
# 服务的 stdout/stderr 单独记在 logs/server.log，两者分开才能各自轮转
#AGENT2API_LOG_FILE=/var/log/agent2api/app.log

# 时区（模块带完整 tzdata，全部 IANA 区名可用，如 Asia/Taipei、Europe/Berlin）
TZ_NAME=Asia/Shanghai

# 额外 DNS，空格分隔；留空则自动探测：系统 props → dumpsys connectivity →
# 公网兜底（223.5.5.5 / 119.29.29.29 / 8.8.8.8）。
# 检测到 IPv6 默认路由且没探到 v6 DNS 时，2400:3200::1 会排到兜底序列最前面
# （glibc 只消费前 3 个 nameserver，排在后面的等于不存在）。
DNS_LIST=

# ── v3.1.1 新增：守护与更新 ──────────────────────────────

# 守护轮询间隔（秒）：日志轮转 / 健康探活 / DNS 重探的节拍
#AGENT2API_POLL_SECS=10

# /health 健康探活（0=关闭）。连续无响应约 3~5 分钟判定假死并自动重启
#AGENT2API_HEALTH_CHECK=1
#AGENT2API_HANG_RESTART=1

# server.log / app.log 单文件上限（MB），超限轮转为 .1
#AGENT2API_LOG_MAX_MB=16

# chroot /tmp 的 tmpfs 上限（默认 64m）
# tmpfs 占的是 RAM 不是磁盘：调大等于预留更多物理内存，只有跑大批量导入/导出才需要
#AGENT2API_TMPFS_SIZE=64m

# ── v3.1.2 新增：内存看门狗 ──────────────────────────────
# 服务进程 RSS 上限（MB）。0 = 自动：物理内存的 1/8，夹在 [256, 1024]。
# 连续 2 次探测超限就优雅重启服务（有日志、有通知），而不是等内核 OOM
# 去杀 system_server / 桌面 —— 那种"手机莫名重启"极难归因。
#AGENT2API_MAX_RSS_MB=0
#AGENT2API_WATCHDOG=1

# 服务进程的 oom_score_adj（默认 -900）。
# -1000 是内核永不回收，泄漏时只能去杀系统进程；-900 仍高于普通应用，
# 但极端压力下可被回收。
#AGENT2API_OOM_SCORE_ADJ=-900

# 升级前数据快照的体积上限（MB），超过就跳过快照（回滚只回滚二进制）
#AGENT2API_SNAPSHOT_MAX_MB=1024

# 回滚归档（update.failed.*）保留份数，每份约 18MB
#AGENT2API_KEEP_FAILED=2

# 在线更新：GitHub 镜像前缀（github.com 的下载走它，api.github.com 不走）
# 国内示例：AGENT2API_MIRROR=https://ghfast.top
#AGENT2API_MIRROR=

# 在线更新：自定义仓库（GitHub 的 owner/name）
# 上游仓库被封/搬家时指到新家；解封后删掉或注释掉这行，就回到默认仓库，
# 不用重刷模块。写法：owner/name，或完整 https://github.com/owner/name(.git)
# 要求：目标仓库的 Release 里要有同名资产
#       agent2api-server-linux-arm64.tar.gz（及 .sha256）
# 注意：若目标仓库的版本号低于当前已装版本，普通更新会拒绝"降级"，
#       可用 ctl update install vX.Y.Z 显式安装。
#AGENT2API_REPO=

# 在线更新·手动投放目录（shell 没有 TLS 能力时的保底通道：
# 手机浏览器从 Release 页下载 tar.gz 放进这个目录，然后 ctl update drop）
#AGENT2API_UPDATE_DROP_DIR=/sdcard/Download

# 拿不到官方 sha256 时是否允许装未校验的包（默认拒绝）
#AGENT2API_UPDATE_ALLOW_UNVERIFIED=0

# 实验性降权：服务进程不再以 root 运行（需要设备 busybox 带 setuidgid；
# 数据/日志目录会 chown 给该 uid；部分设备 SELinux 可能不让跑，失败自动回 root）
#AGENT2API_RUN_UID=
#AGENT2API_RUN_GID=
